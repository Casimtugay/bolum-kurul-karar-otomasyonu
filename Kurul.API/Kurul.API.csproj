<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>270be88b-821c-4b23-8985-4639dd2aafa1</UserSecretsId>
    <!-- Paylaşımlı barındırmanın (MonsterASP ücretsiz plan: 32-bit, sınırlı bellek) uygulama havuzunda
         Server GC açılışta gereğinden fazla bellek ayırır; iş istasyonu GC'si kullanılır. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />

    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />

    <PackageReference Include="QuestPDF" Version="2026.9.1" />

    <!-- PDFsharp 6.2.4 MIT lisanslıdır; 6.5 ve sonrası AGPL olduğu için yükseltilmemeli. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />

    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets/Pdf/*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Geliştirme gizli bilgileri yayın paketine girmez; Production.local.json yayına gider. -->
  <ItemGroup>
    <Content Update="appsettings.Development.local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>