{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Kurul.API",
    "Audience": "Kurul.Web"
  },
  "Storage": {
    "Root": "Storage",
    "MaxFileMB": 25
  },
  "Cors": {
    "Origins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "LoginCaptcha": {
    "Enabled": true
  }
}
